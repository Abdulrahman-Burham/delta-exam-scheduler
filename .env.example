# =====================================================================
# Delta University Exam Invigilation Management System — Environment Config
# =====================================================================

# Backend Security & Cryptography
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Local SQLite fallback: sqlite:///./invigilation.db
# Production PostgreSQL: postgresql://postgres:postgrespassword@localhost:5432/invigilation_db
DATABASE_URL=sqlite:///./invigilation.db

# Production Container Database Configuration (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=invigilation_db
POSTGRES_PORT=5432

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
